@@ -864,6 +864,15 @@ s390_expand_builtin (tree exp, rtx target, rtx subtarget ATTRIBUTE_UNUSED,
 #define MAX_ARGS 6
 
   tree fndecl = TREE_OPERAND (CALL_EXPR_FN (exp), 0);
+  /* None of the S/390-specific builtin facilities belongs to the bounded
+     historical profile.  Check independently of assembler attribute support:
+     otherwise the parent can bypass its feature checks and reach invalid RTL. */
