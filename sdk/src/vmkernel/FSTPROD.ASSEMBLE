* PRODUCTION CANDIDATE. COPY AS FSTGLUE ASSEMBLE IN COMPONENT PACKAGE.
* DISABLED SYSTEM-KEY ENTRY; PRIVATE RESIDENT STACK, NO CMS SERVICES.
* GUARDS REMAIN; NO STACK FILL, HIGH-WATER SCAN OR CALL COUNTER.
FSTGLUE  CSECT
         ENTRY FSTCALL,FSTRD,FSTINFO
         EXTRN FSTCALC
FSTCALL  EQU   *
         LR    1,12
         LR    12,15
         USING FSTCALL,12
         CLI   BUSY,0
         BNE   NESTED
         MVI   BUSY,1
         STM   6,11,SAVED
         ST    1,SAVED+24
         STM   13,14,SAVED+28
         LA    15,CSTACK+1952
         L     1,AFSTCALC
         BALR  14,1
         CLC   GUARDLO(8),MAGIC
         BNE   BADSTACK
         CLC   GUARDHI(8),MAGIC
         BNE   BADSTACK
         B     FINISH
BADSTACK LA    2,12
         MVI   BROKEN,1
FINISH   MVI   BUSY,0
         LR    15,2
         LM    6,11,SAVED
         LM    13,14,SAVED+28
         L     12,SAVED+24
         BR    14
NESTED   LR    12,1
         LA    15,12
         BR    14
FSTRD    L     2,0(,2)
         BR    14
         DS    0D
* KCP1: TWO RESERVED ZERO WORDS, THEN BUSY AND STICKY GUARD-FAIL BYTE.
FSTINFO  DC    C'KCP1',F'0',F'0'
BUSY     DC    X'00'
BROKEN   DC    X'00'
         DC    H'0'
SAVED    DS    9F
AFSTCALC DC    A(FSTCALC)
MAGIC    DC    XL8'5A17C0DE8EEDBEEF'
         DS    0D
GUARDLO  DC    XL8'5A17C0DE8EEDBEEF'
CSTACK   DS    256D
GUARDHI  DC    XL8'5A17C0DE8EEDBEEF'
         END
