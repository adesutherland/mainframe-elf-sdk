* CMS NUCLEUS C GLUE. NATIVE BALR ENTRY, R2/R3/R4 ALGORITHM ARGUMENTS.
* CALLED DISABLED IN SYSTEM KEY. RESIDENT PER-VM STACK, NO ALLOCATION.
FSTGLUE  CSECT
         ENTRY FSTCALL,FSTRD,FSTINFO
         EXTRN FSTCALC
FSTCALL  EQU   *
         LR    1,12
         LR    12,15
         USING FSTCALL,12
         CLI   BUSY,0
         BNE   NESTED
         MVI   BUSY,1
         STM   6,11,SAVED
         ST    1,SAVED+24
         STM   13,15,SAVED+28
         MVC   GUARDLO(8),MAGIC
         MVC   GUARDHI(8),MAGIC
         MVI   CSTACK,X'A5'
         MVC   CSTACK+1(255),CSTACK
         MVC   CSTACK+256(256),CSTACK
         MVC   CSTACK+512(256),CSTACK
         MVC   CSTACK+768(256),CSTACK
         MVC   CSTACK+1024(256),CSTACK
         MVC   CSTACK+1280(256),CSTACK
         MVC   CSTACK+1536(256),CSTACK
         MVC   CSTACK+1792(256),CSTACK
         LA    15,CSTACK+1952
         L     1,AFSTCALC
         BALR  14,1
         ST    2,RESULT
         CLC   GUARDLO(8),MAGIC
         BNE   BADSTACK
         CLC   GUARDHI(8),MAGIC
         BNE   BADSTACK
* MEASURE THIS CALL'S STACK HIGH-WATER WITHOUT ENTERING A CMS SERVICE.
         LA    1,CSTACK
         LA    0,2048
SCAN     CLI   0(1),X'A5'
         BNE   SCANNED
         LA    1,1(,1)
         BCT   0,SCAN
SCANNED  ST    0,FSTUSED
         L     0,CALLS
         A     0,ONE
         ST    0,CALLS
         B     FINISH
BADSTACK LA    2,12
         ST    2,RESULT
         MVI   BROKEN,1
FINISH   MVI   BUSY,0
         L     15,RESULT
         LM    6,11,SAVED
         LM    13,14,SAVED+28
         L     12,SAVED+24
         BR    14
NESTED   LR    12,1
         LA    15,12
         BR    14
* LEAF ACCESSOR USES INTERNAL C ABI. ADDRESS WAS VALIDATED BY FSTCALC.
FSTRD    L     2,0(,2)
         BR    14
         DS    0D
FSTINFO  DC    C'KCF1'
FSTUSED  DC    F'0'
CALLS    DC    F'0'
BUSY     DC    X'00'
BROKEN   DC    X'00'
         DC    H'0'
RESULT   DC    F'0'
SAVED    DS    10F
AFSTCALC DC    A(FSTCALC)
ONE      DC    F'1'
MAGIC    DC    XL8'5A17C0DE8EEDBEEF'
         DS    0D
GUARDLO  DS    D
CSTACK   DS    256D
GUARDHI  DS    D
         END
