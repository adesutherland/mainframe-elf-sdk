PROC 0
CONTROL NOFLUSH
ERROR DO
  SET NATIVERC = &LASTCC
  WRITE ENV NATIVE RC=&NATIVERC
  WRITE ENV HARNESS FAIL
  EXIT CODE(16)
END
WRITE ENV HARNESS BEGIN CLIST
CALL 'LABA01.ENVCMD.LOAD(ENV31)' 'DD:ENVINPUT'
SET NATIVERC = &LASTCC
WRITE ENV NATIVE RC=&NATIVERC
IF &NATIVERC NE 0 THEN DO
  WRITE ENV HARNESS FAIL
  EXIT CODE(&NATIVERC)
END
WRITE ENV CALLER SURVIVED
WRITE ENV HARNESS PASS
EXIT CODE(0)
