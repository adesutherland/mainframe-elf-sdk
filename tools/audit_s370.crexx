/* Strict mnemonic/directive audit for our trusted compiler fixtures.
   This is not a verifier for arbitrary binary images or hostile assembler. */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  if args.0 < 1 | args.0 > 3 then return 2
  data_only = 0
  cms31 = 0
  i = .int
  do i = 2 to args.0
    if args[i] = "--allow-data-only" then data_only = 1
    else if args[i] = "--profile=cms20-esa31-v1" then cms31 = 1
    else return 2
  end
  path = args.1
  address crexx "run test -r :path"
  if rc <> 0 then return 2
  lines = readlines(path)
  count = 0
  do i = 1 to lines.0
    line = strip(translate(lines[i]," ","09"x))
    if line = "" | left(line,1) = "#" then iterate
    op = word(line,1)
    if right(op,1) = ":" then do
      line = strip(substr(line,length(op)+1))
      if line = "" then iterate
      op = word(line,1)
    end
    if pos(" " || op || " "," .file .ident .text .data .bss .section .align .balign .p2align .globl .type .size .quad .long .short .word .byte .string .ascii .base64 .zero .skip .local .comm .set .weak .hidden ") > 0 then iterate
    /* Extended mnemonics for historical BC/BCR, and S/370 byte operations. */
    if cms31 & op = "bsm" then do
      count = count + 1
      iterate
    end
    if pos(" " || op || " "," be bne bh bl bhe ble bz bnz ber bner bhr blr bher bler bzr bnzr icm clm nc oc tm ") > 0 then do
      count = count + 1
      iterate
    end
    if pos(" " || op || " "," a ah ar al alr s sh sr sl slr l lh lr la ltr lcr lpr lnr st sth stc stm lm ic c ch cr cl clr cli clc n nr ni o or oi x xr xi xc mvc mvi m mh mr d dr sll srl sra sla srdl srda sldl slda bal balr bas basr b bc bcr br svc nop nopr ") = 0 then do
      say "S370 AUDIT REJECT:" path "line" i line
      return 2
    end
    count = count + 1
  end
  if count = 0 & data_only = 0 then return 2
  say "S370 AUDIT PASS:" path "instructions=" || count
  return 0
